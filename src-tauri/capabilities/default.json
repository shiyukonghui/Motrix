{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口默认能力（core:default 权限集合 + 事件监听/发送权限，供前端 @tauri-apps/api/event 的 listen/emit/unlisten 使用）",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:event:allow-unlisten",
    "notification:default",
    "opener:default"
  ]
}
